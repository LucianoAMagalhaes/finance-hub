// Prisma schema — the single source of truth for the database structure.
//
// From this file Prisma generates two things:
//   1. SQL migrations (the actual CREATE TABLE statements), via `prisma migrate`
//   2. A fully typed TypeScript client (`@prisma/client`) used to query the DB
//
// Conventions followed here (see CLAUDE.md):
//   - Model fields are English camelCase; @map / @@map point them at the
//     snake_case column/table names from the documented data model.
//   - Money is stored as integer CENTS (e.g. 150000 = R$ 1.500,00) — never floats.
//   - Dates are stored as timestamps (ISO 8601) and formatted on the frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Read from .env — points at the docker-compose Postgres container.
  url      = env("DATABASE_URL")
}

// ----- Enums -------------------------------------------------------------
// Enums become real PostgreSQL types, so the DB itself rejects invalid values.

// A transaction (and a category) is either income or expense.
enum TransactionType {
  income
  expense
}

// The allowed payment methods from the Phase 1 spec.
enum PaymentMethod {
  cash
  debit
  credit
  pix
  transfer
  boleto
}

// ----- Models ------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations: one user owns many categories, subcategories, tags,
  // transactions, budgets and goals.
  categories    Category[]
  subcategories Subcategory[]
  tags          Tag[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]

  @@map("users")
}

// A Category is the top-level "jar" (pote) of the 6-jars budgeting method.
// For expenses: Custos Fixos, Conforto, Prazeres, Metas, Liberdade Financeira,
// Conhecimento. For income it represents the source (Salário, Rendimentos...).
// Every transaction MUST belong to exactly one category.
model Category {
  id    String          @id @default(cuid())
  name  String
  icon  String
  color String
  type  TransactionType

  // Owner of this category.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A category groups many transactions and can have budgets.
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

// A Subcategory is a finer area of spending/earning (Alimentação, Transporte,
// Saúde...). It is chosen FREELY per transaction and is NOT tied to a parent
// category — the same "Transporte" can appear under "Conforto" (gasoline) or
// "Custos Fixos" (bus to work). It is optional on a transaction.
model Subcategory {
  id    String          @id @default(cuid())
  name  String
  icon  String
  color String
  type  TransactionType

  // Owner of this subcategory.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@map("subcategories")
}

// A Tag (marcador) is a reusable free-form label that can be attached to a
// single transaction (income or expense) — e.g. "combustível", "viagem".
// Created once, reused everywhere. A transaction has at most one tag.
model Tag {
  id    String  @id @default(cuid())
  name  String
  // Optional color for the UI chip; null falls back to a neutral default.
  color String?

  // Owner of this tag.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Tag names are unique per user, which makes the seed idempotent and lets the
  // UI reuse an existing tag instead of creating duplicates.
  @@unique([userId, name])
  @@map("tags")
}

model Transaction {
  id            String          @id @default(cuid())
  description   String
  // Amount in integer cents. Always positive; the `type` tells income vs expense.
  amount        Int
  date          DateTime
  type          TransactionType
  paymentMethod PaymentMethod   @map("payment_method")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The "jar" — required.
  categoryId    String       @map("category_id")
  category      Category     @relation(fields: [categoryId], references: [id])
  // The spending area — optional, chosen freely.
  subcategoryId String?      @map("subcategory_id")
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  // At most one reusable marker — optional.
  tagId         String?      @map("tag_id")
  tag           Tag?         @relation(fields: [tagId], references: [id])

  @@map("transactions")
}

model Budget {
  id          String   @id @default(cuid())
  // Spending limit for the category in this period, in integer cents.
  amountLimit Int      @map("amount_limit")
  // Period the budget applies to (month is 1-12).
  month       Int
  year        Int
  createdAt   DateTime @default(now()) @map("created_at")

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  // One budget per category per month/year.
  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

model Goal {
  id                  String   @id @default(cuid())
  name                String
  // Target and current saved amount, in integer cents.
  targetAmount        Int      @map("target_amount")
  currentAmount       Int      @default(0) @map("current_amount")
  deadline            DateTime
  // Suggested monthly contribution, in integer cents.
  monthlyContribution Int      @map("monthly_contribution")
  createdAt           DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}
