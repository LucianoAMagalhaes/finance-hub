// Prisma schema — the single source of truth for the database structure.
//
// From this file Prisma generates two things:
//   1. SQL migrations (the actual CREATE TABLE statements), via `prisma migrate`
//   2. A fully typed TypeScript client (`@prisma/client`) used to query the DB
//
// Conventions followed here (see CLAUDE.md):
//   - Model fields are English camelCase; @map / @@map point them at the
//     snake_case column/table names from the documented data model.
//   - Money is stored as integer CENTS (e.g. 150000 = R$ 1.500,00) — never floats.
//   - Dates are stored as timestamps (ISO 8601) and formatted on the frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Read from .env — points at the docker-compose Postgres container.
  url      = env("DATABASE_URL")
}

// ----- Enums -------------------------------------------------------------
// Enums become real PostgreSQL types, so the DB itself rejects invalid values.

// A transaction (and a category) is either income or expense.
enum TransactionType {
  income
  expense
}

// The allowed payment methods from the Phase 1 spec.
enum PaymentMethod {
  cash
  debit
  credit
  pix
  transfer
  boleto
  direct_debit
}

// ----- Models ------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations: one user owns many categories, tags, bank accounts, transactions
  // and (Phase 2) assets with their operations.
  categories      Category[]
  tags            Tag[]
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  assets          Asset[]
  assetOperations AssetOperation[]
  scoreQuestions  ScoreQuestion[]
  scoreAnswers    ScoreAnswer[]

  @@map("users")
}

// A Category is the top-level "jar" (pote) of the 6-jars budgeting method.
// For expenses: Custos Fixos, Conforto, Prazeres, Metas, Liberdade Financeira,
// Conhecimento. For income it represents the source (Salário, Rendimentos...).
// Every transaction MUST belong to exactly one category.
model Category {
  id            String          @id @default(cuid())
  name          String
  icon          String
  color         String
  type          TransactionType
  // Target share of monthly income allocated to this jar, as a whole-number
  // percentage 0-100 (the "Metas" screen edits these). Only meaningful for
  // expense categories; income categories keep the default 0.
  targetPercent Int             @default(0) @map("target_percent")

  // Owner of this category.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A category groups many transactions.
  transactions Transaction[]

  @@map("categories")
}

// A Tag (marcador) is a reusable free-form label that can be attached to a
// single transaction (income or expense) — e.g. "combustível", "viagem".
// Created once, reused everywhere. A transaction has at most one tag.
model Tag {
  id    String  @id @default(cuid())
  name  String
  // Optional color for the UI chip; null falls back to a neutral default.
  color String?

  // Owner of this tag.
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Tag names are unique per user, which makes the seed idempotent and lets the
  // UI reuse an existing tag instead of creating duplicates.
  @@unique([userId, name])
  @@map("tags")
}

model Transaction {
  id            String          @id @default(cuid())
  description   String
  // Amount in integer cents. Always positive; the `type` tells income vs expense.
  amount        Int
  date          DateTime
  type          TransactionType
  paymentMethod PaymentMethod   @map("payment_method")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")

  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The "jar" — required.
  categoryId String      @map("category_id")
  category   Category    @relation(fields: [categoryId], references: [id])
  // At most one reusable marker — optional.
  tagId      String?     @map("tag_id")
  tag        Tag?        @relation(fields: [tagId], references: [id])
  // The bank account the money moved through — required.
  accountId  String      @map("account_id")
  account    BankAccount @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

// A BankAccount is where money actually sits (checking, savings, wallet…). Its
// current balance = initialBalance + sum(income) − sum(expense) of its
// transactions. Every transaction belongs to exactly one account.
model BankAccount {
  id             String   @id @default(cuid())
  name           String
  // Starting balance in integer cents (before any logged transaction). Can be
  // negative for an account that opened in overdraft.
  initialBalance Int      @default(0) @map("initial_balance")
  // Optional color for the UI; null falls back to a neutral default.
  color          String?
  createdAt      DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@map("bank_accounts")
}

// ----- Phase 2 — Investments ---------------------------------------------
// The investment module is deliberately SEPARATE from the household budget
// above: buying an asset does not create a Transaction and does not touch a
// BankAccount (see ADR-008). The two modules only share the User.

// The asset types the portfolio supports. Shown to the user as "Tipo".
enum AssetType {
  stock_br // ação nacional
  stock_intl // ação internacional (inclui BDR e stock lá fora)
  fii // fundo imobiliário
  crypto
  fixed_income // renda fixa
}

// What an operation did to the position. Dividends (proventos) are a later
// phase; adding them is an `ALTER TYPE ... ADD VALUE` migration.
enum AssetOperationType {
  buy
  sell
}

// Which checklist a question belongs to. An asset's type decides which one it
// is graded by: stock_br and stock_intl share the `stocks` list, fii uses
// `fiis`, and crypto/fixed_income have no checklist at all (manual score).
enum ScoreScope {
  stocks
  fiis
}

// An Asset is one line of the portfolio — a ticker the user holds.
//
// Money keeps living in integer cents everywhere in this app (ADR-005), but a
// QUANTITY of an asset is fractional (0.00123456 BTC) and a unit QUOTE can have
// fractions of a cent, so those two are the only Decimal columns — see ADR-007.
model Asset {
  id                String    @id @default(cuid())
  // Uppercase symbol, unique per user: "PETR4", "HGLG11", "BTC".
  ticker            String
  type              AssetType
  // Current unit quote, typed in by hand for now (brapi.dev / CoinGecko will
  // fill these automatically in a later branch — hence the timestamp).
  //
  // Stored in CENTS like every other amount in this app, but as Decimal: a
  // QUOTE, unlike money that actually moved, can have fractions of a cent (a
  // coin worth R$ 0,000071 is 0.0071 cents). Null = never priced, and the UI
  // then shows "sem cotação" instead of pretending the position is worth 0.
  currentPriceCents Decimal?  @map("current_price_cents") @db.Decimal(20, 6)
  priceUpdatedAt    DateTime? @map("price_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Score typed in by hand, -10..10, ONLY for the types that have no checklist
  // (crypto, fixed_income). Same scale as the derived checklist score so the
  // "Nota" column reads the same for every line. Null = not graded yet.
  manualScore Int? @map("manual_score")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  operations   AssetOperation[]
  scoreAnswers ScoreAnswer[]

  // One row per ticker per user. There is no "name" column on purpose: the
  // ticker IS the identity of the line, and the user registers PURCHASES, not
  // assets — buying PETR4 again reuses this row (recordPurchase looks it up by
  // ticker) and just adds another operation, which is what moves the average
  // price. The unique index is what keeps that reuse honest.
  @@unique([userId, ticker])
  @@map("assets")
}

// An AssetOperation is a buy or a sell. The position (quantity, average price,
// cost) is always DERIVED from these rows by lib/portfolio.ts — never stored,
// so it can never drift from the history.
model AssetOperation {
  id         String             @id @default(cuid())
  type       AssetOperationType
  quantity   Decimal            @db.Decimal(24, 8)
  // The money that actually moved, in integer cents (ADR-005). The unit price
  // is derived (totalCents / quantity), so there are never two fields that can
  // disagree with each other.
  totalCents Int                @map("total_cents")
  date       DateTime
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")

  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: an operation makes no sense without its asset, so deleting the
  // asset deletes its history (the UI confirms, showing how many rows go).
  assetId String @map("asset_id")
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, assetId])
  @@index([assetId, date])
  @@map("asset_operations")
}

// ----- Phase 2 — Asset scoring -------------------------------------------
// The user grades each stock/FII against a checklist of objective yes/no
// questions. Every "sim" adds 1, every "não" subtracts 1, so the score runs
// from -10 to +10 for a 10-question list (see ADR-009). The score is DERIVED
// from the answers by lib/scoring.ts — never stored — for the same reason the
// portfolio position is derived: it can then never disagree with its inputs.

// One question of one checklist. The user writes these in Configurações; the
// seed only offers a starting set when a scope has none.
model ScoreQuestion {
  id        String     @id @default(cuid())
  scope     ScoreScope
  text      String
  // Optional supporting note shown under the question, e.g. "Histórico: 5 anos".
  hint      String?
  // Display order inside its scope. New questions go to the end (max + 1) and
  // the ↑/↓ buttons swap this value with the neighbour's.
  position  Int
  createdAt DateTime   @default(now()) @map("created_at")

  userId  String        @map("user_id")
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ScoreAnswer[]

  @@index([userId, scope, position])
  @@map("score_questions")
}

// One asset's answer to one question. A MISSING row means "not answered yet",
// which is different from `false` ("não", which costs a point) — that is why
// there is no default here and why the UI has a "limpar" action.
model ScoreAnswer {
  id        String   @id @default(cuid())
  value     Boolean
  updatedAt DateTime @updatedAt @map("updated_at")

  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade on both sides: an answer is meaningless without its asset or its
  // question, so deleting either one takes the answer with it (the delete
  // confirmation in Configurações says how many answers go).
  assetId    String        @map("asset_id")
  asset      Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  questionId String        @map("question_id")
  question   ScoreQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // One answer per (asset, question) — the unique index is what lets the save
  // action wipe-and-rewrite an asset's answers without ever duplicating a row.
  @@unique([assetId, questionId])
  @@index([userId, assetId])
  @@map("score_answers")
}
